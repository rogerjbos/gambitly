<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer on Android 12+. content.db is copied from the APK, so it is left out. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="content.db" />
        <exclude domain="database" path="content.db-shm" />
        <exclude domain="database" path="content.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="content.db" />
        <exclude domain="database" path="content.db-shm" />
        <exclude domain="database" path="content.db-wal" />
    </device-transfer>
</data-extraction-rules>
